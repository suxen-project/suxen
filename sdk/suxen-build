#!/bin/sh
# suxen-build assembles a custom suxen binary from the suxen source tree and
# any number of external plugin modules. It generates a main package that
# blank-imports the requested plugins (so their init functions register
# drivers and formats through the spi packages) and compiles it against the
# suxen sources shipped in this image.
set -eu

SUXEN_SOURCE="${SUXEN_SOURCE:-/opt/suxen}"
# Resolve caller-supplied paths before switching to the generated build directory.
CALLER_DIR="$(pwd -P)"
OUTPUT="/out/suxen"
VERSION="custom"
TAGS=""
PLUGINS=""
REPLACES=""

go_quote() {
	# Paths in go.mod and generated Go imports use string syntax.
	printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; 1s/^/"/; $s/$/"/'
}

usage() {
	cat >&2 <<'EOF'
usage: suxen-build [options]

  --plugin <module>[=<dir>]  Import a plugin package. Repeatable. With =<dir>,
                             the module is resolved from that local directory
                             (a replace directive); without it, it is fetched
                             from the module proxy.
  --with-defaults            Include the standard in-tree suxen plugin set.
                             Enabled unless --no-defaults is given.
  --no-defaults              Exclude the default suxen plugin set.
  --tags <tags>              Extra Go build tags (comma separated).
  --output <path>            Output binary path (default /out/suxen).
  --version <version>        Version string baked into the binary.

Relative source, plugin directory, and output paths resolve from the caller's
working directory.

example:
  suxen-build --plugin example.com/my/plugin=/work --output /out/suxen
EOF
	exit 2
}

DEFAULTS=1
while [ $# -gt 0 ]; do
	case "$1" in
	--plugin)
		[ $# -ge 2 ] || usage
		module="${2%%=*}"
		[ -n "$module" ] || usage
		case "$module" in *'
'*) usage ;; esac
		PLUGINS="${PLUGINS}${module}
"
		case "$2" in
		*=*)
			plugin_dir="${2#*=}"
			[ -n "$plugin_dir" ] || usage
			case "$plugin_dir" in *'
'*) usage ;; esac
			case "$plugin_dir" in
			/*) ;;
			*) plugin_dir="$CALLER_DIR/$plugin_dir" ;;
			esac
			case "$plugin_dir" in
			*'\'*) echo "suxen-build: Go module replacement paths cannot contain backslashes" >&2; exit 2 ;;
			esac
			REPLACES="${REPLACES}${module}=${plugin_dir}
"
			;;
		esac
		shift 2
		;;
	--with-defaults) DEFAULTS=1; shift ;;
	--no-defaults) DEFAULTS=0; shift ;;
	--tags)
		[ $# -ge 2 ] || usage
		TAGS="$2"; shift 2 ;;
	--output)
		[ $# -ge 2 ] || usage
		[ -n "$2" ] || usage
		OUTPUT="$2"; shift 2 ;;
	--version)
		[ $# -ge 2 ] || usage
		VERSION="$2"; shift 2 ;;
	*) usage ;;
	esac
done

case "$SUXEN_SOURCE" in
	/*) ;;
	*) SUXEN_SOURCE="$CALLER_DIR/$SUXEN_SOURCE" ;;
esac
case "$SUXEN_SOURCE" in *'
'*) echo "suxen-build: source path cannot contain a newline" >&2; exit 2 ;; esac
case "$SUXEN_SOURCE" in
*'\'*) echo "suxen-build: Go module replacement paths cannot contain backslashes" >&2; exit 2 ;;
esac
case "$OUTPUT" in
	/*) ;;
	*) OUTPUT="$CALLER_DIR/$OUTPUT" ;;
esac

[ -d "$SUXEN_SOURCE" ] || { echo "suxen-build: suxen source not found at $SUXEN_SOURCE" >&2; exit 1; }

BUILD_DIR="$(mktemp -d)"
trap 'rm -rf "$BUILD_DIR"' EXIT

{
	echo "// Code generated by suxen-build. DO NOT EDIT."
	echo "package main"
	echo
	echo "import ("
	if [ "$DEFAULTS" = 1 ]; then
		echo "	_ \"github.com/suxen-project/suxen/plugins/builtin\""
	fi
	printf '%s' "$PLUGINS" | while IFS= read -r module; do
		printf '\t_ %s\n' "$(go_quote "$module")"
	done
	echo
	echo "	\"github.com/suxen-project/suxen/suxencmd\""
	echo ")"
	echo
	echo "func main() { suxencmd.Main() }"
} > "$BUILD_DIR/main.go"

GO_DIRECTIVE="$(grep '^go ' "$SUXEN_SOURCE/go.mod" | head -1)"
{
	echo "module suxen.invalid/custom-build"
	echo
	echo "$GO_DIRECTIVE"
	echo
	echo "require github.com/suxen-project/suxen v0.0.0"
	echo
	printf 'replace github.com/suxen-project/suxen => %s\n' "$(go_quote "$SUXEN_SOURCE")"
	printf '%s' "$REPLACES" | while IFS= read -r pair; do
		printf 'replace %s => %s\n' "${pair%%=*}" "$(go_quote "${pair#*=}")"
	done
} > "$BUILD_DIR/go.mod"

cd "$BUILD_DIR"
go mod tidy
mkdir -p "$(dirname "$OUTPUT")"
CGO_ENABLED=0 go build \
	${TAGS:+-tags="$TAGS"} \
	-trimpath \
	-ldflags="-s -w -X github.com/suxen-project/suxen/internal/server.Version=$VERSION" \
	-o "$OUTPUT" \
	.
echo "suxen-build: wrote $OUTPUT"
